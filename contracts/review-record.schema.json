{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer",
    "reviewedAt",
    "verdict",
    "defectIds"
  ],
  "properties": {
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "PENDING",
        "APPROVED",
        "CHANGES_REQUIRED",
        "BLOCKED"
      ]
    },
    "defectIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
