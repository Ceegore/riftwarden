{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "riftwarden.phase11.published-ids",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "ids"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          },
          "replacementId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
