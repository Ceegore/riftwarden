{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "riftwarden.phase10.content-ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "category",
    "expectedCount",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "gateCritical",
        "supplementaryAuthoritative"
      ]
    },
    "expectedCount": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slotId",
          "authorityLabel",
          "sourceLocator",
          "status",
          "review",
          "fidelity",
          "localization",
          "assetRequirements"
        ]
      }
    }
  }
}
