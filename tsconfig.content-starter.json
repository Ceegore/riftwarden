{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "content/schemas/**/*.ts",
    "src/game/content/**/*.ts",
    "tests/types/**/*.d.ts"
  ]
}
