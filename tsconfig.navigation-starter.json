{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/types/**/*.d.ts"
  ]
}
