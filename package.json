{
  "name": "riftwarden-auto-rpg-roguelite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "node tools/env/validate.mjs --channel dev && vite --mode dev",
    "build": "pnpm build:release",
    "build:dev": "node tools/build/run-build.mjs dev",
    "build:qa": "node tools/build/run-build.mjs qa",
    "build:release": "node tools/build/run-build.mjs release",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0 && node tools/lint/check-todos.mjs",
    "lint:fix": "eslint . --fix --max-warnings 0 && node tools/lint/check-todos.mjs",
    "lint:negative": "node tools/lint/run-negative-fixtures.mjs",
    "localization:validate": "node tools/locales/validate.mjs",
    "format": "pnpm lint:fix && node tools/format/write-format.mjs",
    "format:check": "node tools/format/check-format.mjs && pnpm lint",
    "test:unit": "vitest run --project unit",
    "test:sim": "vitest run --project simulation",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:tooling": "node --test tests/tooling/version-resolution.test.mjs tests/tooling/license.test.mjs tests/tooling/environment.test.mjs tests/tooling/phase03/*.test.mjs",
    "toolchain:resolve": "node tools/toolchain/resolve-versions.mjs",
    "toolchain:apply": "node tools/toolchain/apply-freeze.mjs",
    "toolchain:verify": "node tools/toolchain/verify-freeze.mjs",
    "toolchain:licenses": "node tools/toolchain/verify-licenses.mjs",
    "toolchain:postinstall-audit": "node tools/toolchain/audit-postinstall.mjs",
    "toolchain:capture-native": "node tools/toolchain/capture-native-toolchains.mjs",
    "verify:phase02": "node tools/repo/verify-phase02.mjs",
    "ci:verify-workflows": "node tools/ci/verify-workflows.mjs",
    "ci:gate-map": "node tools/ci/create-gate-map.mjs",
    "ci:assert-results": "node tools/ci/assert-needs-results.mjs",
    "ci:verify-branch-evidence": "node tools/ci/verify-branch-protection-evidence.mjs",
    "build:manifest": "node tools/build/create-manifest.mjs",
    "build:hash-tree": "node tools/build/hash-tree.mjs",
    "deps:capture": "node tools/deps/capture.mjs",
    "deps:report": "node tools/deps/report.mjs",
    "deps:sbom": "node tools/deps/create-cyclonedx.mjs",
    "deps:diff": "node tools/deps/diff.mjs",
    "security:audit": "node tools/security/run-audit.mjs",
    "security:secrets": "node tools/security/scan-secrets.mjs",
    "security:artifact-paths": "node tools/security/check-artifact-allowlist.mjs",
    "test:phase03-tooling": "node --test tests/tooling/phase03/*.test.mjs",
    "verify:phase03": "node tools/repo/verify-phase03.mjs",
    "verify:repo": "node tools/repo/verify-root.mjs",
    "check:text-normalization": "node tools/repo/check-text-normalization.mjs",
    "check:file-length": "node tools/check-file-length.mjs",
    "test:repo": "node --test tests/unit/repo/*.test.mjs",
    "requirements:validate": "node tools/requirements/validate.mjs --mode=gate",
    "cap:sync": "pnpm build:release && cap sync",
    "native:config:diff": "node tools/native/verify-config.mjs . && node tools/native/verify-plugin-contracts.mjs .",
    "native:env": "node tools/native/report-environment.mjs > artifacts/native/environment.json",
    "native:hash": "node tools/native/hash-tree.mjs . android ios capacitor.config.ts > artifacts/native/tree.json",
    "verify:native-config": "node tools/native/verify-config.mjs",
    "verify:plugin-contracts": "node tools/native/verify-plugin-contracts.mjs",
    "android:debug": "node tools/native/run-gradle.mjs assembleDebug",
    "android:debug:smoke": "node tools/native/run-gradle.mjs assembleDebug",
    "android:release-manifest": "node tools/native/run-gradle.mjs processReleaseMainManifest",
    "verify:phase04": "node tools/native/verify-g04.mjs",
    "test:phase04-tooling": "node --test tests/tooling/phase04-tools.test.mjs",
    "test:phase05": "vitest run tests/unit/boot-state.spec.ts tests/unit/lifecycle-coordinator.spec.ts tests/unit/diagnostics.spec.ts tests/unit/renderer-capability.spec.ts tests/integration/app-boot.spec.ts",
    "verify:phase05:contracts": "node tools/phase05/verify-contracts.mjs",
    "verify:phase05:source": "node tools/phase05/verify-source-shape.mjs",
    "verify:phase05:copy": "node tools/phase05/verify-copy-parity.mjs",
    "verify:phase05:evidence": "node tools/phase05/verify-evidence.mjs",
    "verify:g05": "node tools/phase05/verify-g05.mjs",
    "ui:tokens:build": "node tools/ui/build-tokens.mjs .",
    "ui:tokens:validate": "node tools/ui/validate-tokens.mjs .",
    "ui:tokens:validate:release": "node tools/ui/validate-tokens.mjs --release .",
    "ui:fonts:validate": "node tools/ui/validate-fonts.mjs .",
    "ui:release-scan": "node tools/ui/scan-release-bundle.mjs dist",
    "test:ui-contracts": "node --test tests/ui/*.test.mjs",
    "nav:build-registry": "node tools/navigation/build-screen-registry.mjs .",
    "nav:validate": "node tools/navigation/validate-navigation.mjs .",
    "nav:validate:release": "node tools/navigation/validate-navigation.mjs . --release",
    "test:navigation": "node --test tests/navigation/*.test.mjs",
    "typecheck:navigation-starter": "tsc -p tsconfig.navigation-starter.json",
    "typecheck:content-starter": "tsc -p tsconfig.content-starter.json",
    "content:validate": "node tools/content/validate-content.mjs --root . --profile fixture",
    "content:baseline:freeze": "node tools/content/extraction/freeze-baseline.mjs",
    "content:build": "node tools/content/compile.mjs --root . --profile fixture --out content/generated",
    "content:build:verify": "node tools/content/verify-build-reproducibility.mjs .",
    "content:extraction:release": "node tools/content/extraction/validate-release.mjs",
    "content:ledger:counts": "node tools/content/extraction/validate-counts.mjs",
    "content:ledger:validate": "node tools/content/extraction/validate-ledger.mjs",
    "content:review:batches": "node tools/content/extraction/generate-review-batches.mjs 12",
    "test:content": "node --test tests/content/*.test.mjs",
    "test:content-extraction": "node --test tests/content-extraction/*.test.mjs",
    "test:rules": "node --test tests/rules/*.test.mjs && vitest run --project rules",
    "test:math": "node --test tests/math/*.test.mjs && vitest run --project math",
    "math:audit": "node tools/math/audit-math-callsites.mjs src",
    "math:vectors": "node tools/math/generate-crossruntime-vectors.mjs",
    "math:validate-readiness": "node tools/math/validate-phase11-readiness.mjs",
    "test:random": "node --test tests/random/*.test.mjs && vitest run --project random --project replay",
    "random:audit": "node tools/random/audit-random-callsites.mjs src",
    "random:slots": "node tools/random/validate-roll-slot-registry.mjs",
    "random:golden": "node tools/random/validate-golden-seeds.mjs",
    "random:vectors": "node tools/random/generate-reference-vectors.mjs",
    "random:validate-readiness": "node tools/random/validate-phase12-readiness.mjs",
    "test:kernel": "node --test tests/sim/*.test.mjs && vitest run --project kernel",
    "kernel:audit": "node tools/sim/audit-kernel-imports.mjs",
    "kernel:validate-readiness": "node tools/sim/validate-phase13-readiness.mjs",
    "rules:typecheck": "tsc -p tsconfig.type-fixtures.json --noEmit",
    "rules:audit": "node tools/rules/audit-magic-values.mjs src config/magic-value-allowlist.json",
    "rules:validate-snapshots": "node tools/rules/validate-rule-snapshots.mjs .",
    "rules:validate-published-ids": "node tools/rules/validate-published-ids.mjs",
    "rules:validate-readiness": "node tools/rules/validate-phase10-readiness.mjs",
    "content:report": "node tools/content/create-content-report.mjs --root .",
    "content:schemas:export": "node tools/content/export-json-schema.mjs --out content/generated/json-schema"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14",
    "motion": "12.42.2",
    "pixi.js": "8.19.0",
    "zod": "4.4.3",
    "@capacitor/core": "8.4.2",
    "@capacitor/android": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/screen-orientation": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/browser": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "@vitejs/plugin-react": "6.0.4",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.7.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.65.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.20.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [],
    "overrides": {
      "brace-expansion": ">=5.0.8"
    }
  }
}
